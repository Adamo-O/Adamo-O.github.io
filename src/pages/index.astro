---
import { getCollection, render } from "astro:content";
import {
  ArrowUpRight,
  FileText,
  Github,
  Linkedin,
  Mail,
} from "lucide-astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button.astro";
import Project from "@/components/Project.astro";
import Experience from "@/components/Experience.astro";
import Hero from "@/components/hero/Hero.astro";
import Footer from "@/components/layout/Footer.astro";
import Section from "@/components/layout/Section.astro";
import Shell from "@/components/layout/Shell.astro";
import PublicationCard from "@/components/home/PublicationCard.astro";
import EducationItem from "@/components/home/EducationItem.astro";
import AwardItem from "@/components/home/AwardItem.astro";
import { profile } from "@/data/profile";
import { sortContent } from "@/lib/utils";

const containsPlaceholder = (value: unknown): boolean => {
  if (typeof value === "string") return /TODO\s*\(/i.test(value);
  if (Array.isArray(value)) return value.some(containsPlaceholder);
  if (value && typeof value === "object") {
    return Object.values(value as Record<string, unknown>).some(containsPlaceholder);
  }
  return false;
};

const [projectsRaw, experiencesRaw, publicationsRaw, educationRaw, awardsRaw] =
  await Promise.all([
    getCollection("projects"),
    getCollection("experience"),
    getCollection("publications"),
    getCollection("education"),
    getCollection("awards"),
  ]);

const projects = (
  await Promise.all(
    projectsRaw
      .filter((project) => !project.data.hidden && !containsPlaceholder(project.data))
      .map(async (project) => {
        const { Content } = await render(project);
        return { ...project, Content };
      }),
  )
).sort((a, b) => sortContent(a.data.dates, b.data.dates));

const experiences = (
  await Promise.all(
    experiencesRaw
      .filter((experience) => !experience.data.hidden && !containsPlaceholder(experience.data))
      .map(async (experience) => {
        const { Content } = await render(experience);
        return { ...experience, Content };
      }),
  )
).sort((a, b) => sortContent(a.data.dates, b.data.dates));

const primaryExperiences = experiences.filter((experience) => !experience.data.collapsed);
const earlierExperiences = experiences.filter((experience) => experience.data.collapsed);

const publications = publicationsRaw
  .filter((publication) => !publication.data.hidden && !containsPlaceholder(publication.data))
  .sort(
    (a, b) =>
      Number(b.data.highlight) - Number(a.data.highlight) ||
      b.data.year - a.data.year ||
      a.data.title.localeCompare(b.data.title),
  );

const education = educationRaw.sort((a, b) => a.data.order - b.data.order);
const awards = awardsRaw.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title={`${profile.name} — AI researcher & software engineer`}>
  <Shell variant="home">
    <Section
      id="about"
      heading="ABOUT"
      title="About"
      rail="AI AGENTS · COMPUTER VISION"
      class="min-h-[calc(100svh-4rem)] items-center lg:min-h-svh"
      hideMobileTitle
    >
      <Hero />
    </Section>

    <Section
      id="research"
      heading="RESEARCH"
      title="Research"
      rail="CURRENT WORK"
      class="border-t border-line"
    >
      <div class="max-w-[52rem] space-y-8">
        <header class="max-w-2xl">
          <p class="text-xl font-medium leading-snug text-fg md:text-2xl">
            {profile.heroLines[1]}
          </p>
        </header>

        {
          publications.length > 0 ? (
            <div class="grid gap-4">
              {publications.map((publication) => (
                <PublicationCard publication={publication.data} />
              ))}
            </div>
          ) : (
            <div class="rounded border border-dashed border-line bg-surface/50 px-5 py-4">
              <p class="text-sm leading-relaxed text-muted">
                Publication details are being prepared and will appear here when ready.
              </p>
            </div>
          )
        }
      </div>
    </Section>

    <Section
      id="projects"
      heading="PROJECTS"
      title="Projects"
      rail="SELECTED BUILDS"
      class="border-t border-line"
    >
      <div class="space-y-5">
        <p class="max-w-2xl text-base leading-relaxed text-muted">
          A selection of full-stack, machine-learning, game, and hardware projects.
        </p>
        <div class="grid gap-5">
          {
            projects.map((project) => (
              <Project frontmatter={project.data}>
                <project.Content />
              </Project>
            ))
          }
        </div>
      </div>
    </Section>

    <Section
      id="experience"
      heading="EXPERIENCE"
      title="Experience"
      rail="WORK & TEACHING"
      class="border-t border-line"
    >
      <div class="grid gap-4">
        {
          primaryExperiences.map((experience) => (
            <Experience frontmatter={experience.data}>
              <experience.Content />
            </Experience>
          ))
        }

        {
          earlierExperiences.length > 0 && (
            <details class="group rounded border border-line bg-surface/60">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-sm font-semibold text-fg marker:hidden">
                Earlier roles
                <span class="meta transition-transform duration-fast group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="grid gap-4 border-t border-line p-4 md:p-5">
                {earlierExperiences.map((experience) => (
                  <Experience frontmatter={experience.data} compact>
                    <experience.Content />
                  </Experience>
                ))}
              </div>
            </details>
          )
        }
      </div>
    </Section>

    <Section
      id="education"
      heading="EDUCATION"
      title="Education"
      rail="ACADEMIC PATH"
      class="border-t border-line"
    >
      <ol class="relative grid gap-0 before:absolute before:bottom-6 before:left-[5px] before:top-6 before:w-px before:bg-line">
        {education.map((entry) => <EducationItem education={entry.data} />)}
      </ol>
    </Section>

    <Section
      id="awards"
      heading="AWARDS"
      title="Awards"
      rail="RECOGNITION"
      class="border-t border-line"
    >
      <div class="grid gap-px overflow-hidden rounded border border-line bg-line sm:grid-cols-2">
        {awards.map((entry) => <AwardItem award={entry.data} />)}
      </div>
    </Section>

    <Section
      id="contact"
      heading="CONTACT"
      title="Contact"
      rail="LET'S TALK"
      class="border-y border-line"
      contentClass="py-16 md:py-24"
    >
      <div class="max-w-[46rem]">
        <h2 class="max-w-2xl text-3xl font-bold leading-tight tracking-tight text-fg md:text-5xl">
          Have a research question or a project worth exploring?
        </h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg">
          The most direct way to reach me is by email. You can also find my work and professional history below.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={`mailto:${profile.email}`} title={`Email ${profile.name}`} staticSize>
            <Mail size="18" aria-hidden="true" />
            Email me
          </Button>
          <Button href={profile.cvPdf} title="Open CV (PDF)" newTab variant="outline" staticSize>
            <FileText size="18" aria-hidden="true" />
            View CV
          </Button>
        </div>

        <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-5" aria-label="External profiles">
          <a class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-accent" href={profile.links.github} target="_blank" rel="noopener noreferrer">
            <Github size="17" aria-hidden="true" /> GitHub <ArrowUpRight size="14" aria-hidden="true" />
          </a>
          <a class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-accent" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
            <Linkedin size="17" aria-hidden="true" /> LinkedIn <ArrowUpRight size="14" aria-hidden="true" />
          </a>
        </nav>
      </div>
    </Section>

    <Footer />
  </Shell>
</Layout>
