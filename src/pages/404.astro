---
import Layout from "@/layouts/Layout.astro";
import Shell from "@/components/layout/Shell.astro";
import VerticalHeading from "@/components/layout/VerticalHeading.astro";
import Button from "@/components/Button.astro";
---

<Layout title="Not found - Adamo Orsini" noindex>
  <Shell variant="page" backLabel="Home">
    <div class="flex min-h-[60vh] items-start gap-8">
      <VerticalHeading label="404" class="max-sm:hidden" />
      <div class="pt-2">
        <p class="meta">Page not found</p>
        <h1 class="mt-2 text-display font-extrabold tracking-tight">Nothing here.</h1>
        <p class="mt-3 max-w-prose text-muted">
          The page you were looking for does not exist or has moved.
        </p>
        <div class="mt-6">
          <Button href="/" staticSize>Back to the homepage</Button>
        </div>
      </div>
    </div>
  </Shell>
</Layout>
