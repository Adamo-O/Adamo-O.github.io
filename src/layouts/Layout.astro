---
/**
 * HTML shell: head metadata, fonts, theme pre-paint script, global styles.
 * Page structure (sidebar, sections) lives in components/layout/Shell.astro.
 */
import "@/styles/globals.css";
import { profile } from "@/data/profile";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = profile.description,
  ogImage = "/og.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? profile.site);
const ogImageUrl = new URL(ogImage, Astro.site ?? profile.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme, before any paint: localStorage.theme, else prefers-color-scheme. -->
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var t = localStorage.getItem("theme");
          var dark =
            t === "dark" ||
            (t !== "light" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) root.classList.add("dark");

          var sidebar = localStorage.getItem("sidebar");
          var compact =
            sidebar === "compact" ||
            (sidebar !== "expanded" &&
              window.matchMedia("(min-width: 1024px) and (max-width: 1279px)").matches);
          if (compact) root.classList.add("sidebar-compact");
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1117" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Devicon: skill icons (only external stylesheet). Version-pinned (@latest
         shipped whatever was current, unreviewed) and loaded non-blocking, since
         the chips are decorative and ~813 KB should not hold up first paint. -->
    <link
      rel="preconnect"
      href="https://cdn.jsdelivr.net"
      crossorigin
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        type="text/css"
        href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
      />
    </noscript>
  </head>
  <body class="bg-bg text-fg font-sans antialiased">
    <slot />
  </body>
</html>
