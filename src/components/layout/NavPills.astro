---
/**
 * Pill navigation. Props:
 *  items: NavItem[] (href, label, icon?, outline?)
 *  orientation: "vertical" | "horizontal"
 *  showIcons?: boolean (default true)
 *  class?: string
 * Every anchor carries `data-nav-link`; scrollSpy.ts sets aria-current="true".
 */
import { cn } from "@/lib/utils";
import type { NavItem } from "./nav";
import NavIcon from "./NavIcon.astro";

interface Props {
  items: NavItem[];
  orientation?: "vertical" | "horizontal";
  showIcons?: boolean;
  class?: string;
  label?: string;
}

const {
  items,
  orientation = "vertical",
  showIcons = true,
  class: className,
  label = "Site",
} = Astro.props;
---

<nav aria-label={label} class={className}>
  <ul
    class={cn(
      "flex gap-1",
      orientation === "vertical" ? "flex-col" : "flex-row flex-wrap items-center",
    )}
  >
    {
      items.map((item) => (
        <li class={cn(orientation === "vertical" && item.outline && "mt-3 border-t border-line pt-3")}>
          <a
            href={item.href}
            data-nav-link
            data-label={item.label}
            aria-label={item.label}
            title={orientation === "vertical" ? item.label : undefined}
            class={cn(
              "sidebar-nav-link group relative flex min-h-10 items-center gap-2.5 rounded-sm px-3 py-2 text-sm font-medium",
              "transition-colors duration-fast",
              "text-fg/75 hover:bg-accent-soft/60 hover:text-accent dark:hover:bg-accent-soft/10",
              "aria-[current=true]:bg-accent-soft/80 aria-[current=true]:text-accent-strong dark:aria-[current=true]:bg-accent-soft/15 dark:aria-[current=true]:text-accent-strong",
              orientation === "horizontal" && "min-h-11 px-3 py-2",
            )}
          >
            <span
              aria-hidden="true"
              class="absolute inset-y-2 left-0 w-px bg-accent opacity-0 transition-opacity duration-fast group-aria-[current=true]:opacity-100"
            ></span>
            {showIcons && item.icon && (
              <NavIcon
                name={item.icon}
                size={16}
                class="shrink-0 opacity-70 group-hover:opacity-100 group-aria-[current=true]:opacity-100"
              />
            )}
            <span class={orientation === "vertical" ? "sidebar-nav-label" : undefined}>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
