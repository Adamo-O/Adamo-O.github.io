---
/** One-line footer strip. */
import { profile } from "@/data/profile";
const year = new Date().getFullYear();
---

<footer class="border-t border-line px-5 py-6 md:px-8 max-md:pb-24">
  <p class="meta flex flex-wrap items-center gap-x-2 gap-y-1 normal-case tracking-normal">
    <span>© {year} {profile.name}</span>
    <span aria-hidden="true">·</span>
    <span>Built with Astro</span>
    <span aria-hidden="true">·</span>
    <a href={profile.links.source} class="hover:text-accent" target="_blank" rel="noopener noreferrer">Source</a>
    <span aria-hidden="true">·</span>
    <span>Updated {profile.now.updated}</span>
  </p>
</footer>
