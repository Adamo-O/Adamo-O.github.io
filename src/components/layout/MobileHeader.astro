---
/**
 * Sticky top bar below lg: name, email icon, ThemeToggle. From md up it also
 * shows the horizontal pill nav (the bottom tab bar is md:hidden).
 */
import { Mail } from "lucide-astro";
import { profile } from "@/data/profile";
import { NAV_ITEMS, CV_ITEM } from "./nav";
import NavPills from "./NavPills.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 lg:hidden">
  <div class="flex h-14 items-center justify-between px-5 md:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${profile.name}, home`}>
      <span
        class="flex h-8 w-8 items-center justify-center rounded-sm border border-line bg-accent-soft/70 text-xs font-extrabold tracking-tight text-accent dark:bg-accent-soft/15"
        aria-hidden="true"
      >
        {profile.initials}
      </span>
      <span class="text-sm font-bold tracking-tight">{profile.name}</span>
    </a>
    <div class="flex items-center gap-1.5">
      <a
        href={`mailto:${profile.email}`}
        title="Email"
        aria-label="Email"
        class="inline-flex h-9 w-9 items-center justify-center rounded-pill border border-line bg-surface text-muted transition-colors duration-fast hover:border-accent hover:text-accent"
      >
        <Mail size={16} aria-hidden="true" />
      </a>
      <ThemeToggle />
    </div>
  </div>
  <div class="hidden border-t border-line px-6 py-2 md:block">
    <NavPills
      items={[...NAV_ITEMS, CV_ITEM]}
      orientation="horizontal"
      showIcons={false}
      label="Sections"
    />
  </div>
</header>
