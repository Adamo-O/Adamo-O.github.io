---
/**
 * Compact identity block at the top of the sidebar.
 * Without a portrait it renders an accent-soft monogram.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  role: string;
  affiliations: string[];
  initials?: string;
  portrait?: ImageMetadata;
}

const {
  name,
  role,
  affiliations,
  initials = name
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase(),
  portrait,
} = Astro.props;
---

<a
  href="/"
  class="sidebar-identity group flex min-h-14 items-center gap-3 rounded-sm px-2 py-2 transition-colors duration-fast hover:bg-accent-soft/60 dark:hover:bg-accent-soft/10"
  aria-label={`${name}, home`}
  title={name}
>
  <div class="sidebar-identity-mark flex h-11 w-11 shrink-0 overflow-hidden rounded-sm border border-line bg-accent-soft/70 dark:bg-accent-soft/15">
    {
      portrait ? (
        <Image
          src={portrait}
          alt={`Portrait of ${name}`}
          width={176}
          densities={[1, 2]}
          class="h-full w-full object-cover"
          loading="eager"
        />
      ) : (
        <span
          class="flex h-full w-full items-center justify-center text-base font-extrabold tracking-tight text-accent"
          aria-hidden="true"
        >
          {initials}
        </span>
      )
    }
  </div>
  <div class="sidebar-copy min-w-0 flex-1">
    <p class="truncate text-sm font-bold leading-tight tracking-tight text-fg">{name}</p>
    <p class="mt-1 text-[12px] leading-snug text-muted">{role}</p>
    <p class="mt-0.5 text-[11px] leading-snug text-muted">
      {affiliations.join(" · ")}
    </p>
  </div>
</a>
