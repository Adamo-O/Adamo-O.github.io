---
/**
 * Outer page structure.
 * Props: variant: "home" | "page" (default "home"), portrait?: ImageMetadata, backHref?, backLabel?
 *  home: skip link, MobileHeader, [Sidebar | main], MobileNav
 *  page: skip link, slim top bar (Back link, slot "actions", ThemeToggle), centred main
 * Slots: default (page content), actions (page variant top bar, right side).
 */
import { ArrowLeft } from "lucide-astro";
import type { ImageMetadata } from "astro";
import { cn } from "@/lib/utils";
import Sidebar from "./Sidebar.astro";
import MobileHeader from "./MobileHeader.astro";
import MobileNav from "./MobileNav.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  variant?: "home" | "page";
  portrait?: ImageMetadata;
  backHref?: string;
  backLabel?: string;
  class?: string;
}

const {
  variant = "home",
  portrait,
  backHref = "/",
  backLabel = "Back",
  class: className,
} = Astro.props;
---

<a href="#content" class="skip-link !fixed">Skip to content</a>

{
  variant === "home" ? (
    <>
      <MobileHeader />
      <div class="sidebar-shell mx-auto max-w-[1440px] lg:grid">
        <Sidebar portrait={portrait} />
        <main id="content" tabindex="-1" class={cn("min-w-0", className)}>
          <slot />
        </main>
      </div>
      <MobileNav />
    </>
  ) : (
    <>
      <header class="no-print sticky top-0 z-40 border-b border-line bg-bg/95">
        <div class="mx-auto flex h-14 max-w-[52rem] items-center justify-between px-5 md:px-8">
          <a
            href={backHref}
            class="inline-flex min-h-11 items-center gap-2 rounded-pill px-3 py-2 text-sm font-medium text-fg/85 transition-colors duration-fast hover:bg-accent-soft/70 hover:text-accent dark:hover:bg-accent-soft/15"
          >
            <ArrowLeft size={16} aria-hidden="true" />
            {backLabel}
          </a>
          <div class="flex items-center gap-2">
            <slot name="actions" />
            <ThemeToggle class="h-11 w-11" />
          </div>
        </div>
      </header>
      <main
        id="content"
        tabindex="-1"
        class={cn("mx-auto w-full max-w-[52rem] px-5 py-10 md:px-8", className)}
      >
        <slot />
      </main>
    </>
  )
}

<script>
  import "@/scripts/cursorGlow";
</script>
