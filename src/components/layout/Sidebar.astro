---
/**
 * Persistent left column at lg+. Contains LabPass, NavPills, social row,
 * ThemeToggle and a footer line. Props: portrait?: ImageMetadata, class?
 */
import { Github, Linkedin, Mail, GraduationCap, PanelLeftClose, PanelLeftOpen } from "lucide-astro";
import type { ImageMetadata } from "astro";
import { cn } from "@/lib/utils";
import { profile } from "@/data/profile";
import { NAV_ITEMS, CV_ITEM } from "./nav";
import LabPass from "./LabPass.astro";
import NavPills from "./NavPills.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  portrait?: ImageMetadata;
  class?: string;
}
const { portrait, class: className } = Astro.props;

const socials = [
  { href: profile.links.github, label: "GitHub", Icon: Github },
  { href: profile.links.linkedin, label: "LinkedIn", Icon: Linkedin },
  ...(profile.links.scholar
    ? [{ href: profile.links.scholar, label: "Google Scholar", Icon: GraduationCap }]
    : []),
  { href: `mailto:${profile.personalEmail}`, label: "Email", Icon: Mail },
];
---

<aside
  class={cn(
    "sidebar hidden lg:sticky lg:top-0 lg:flex lg:h-dvh lg:flex-col lg:self-start lg:overflow-visible",
    "border-r border-line bg-bg/60 p-4",
    className,
  )}
  aria-label="Sidebar"
>
  <LabPass
    name={profile.name}
    role={profile.role}
    affiliations={profile.affiliations}
    initials={profile.initials}
    portrait={portrait}
  />

  <NavPills items={[...NAV_ITEMS, CV_ITEM]} orientation="vertical" class="mt-6" label="Sections" />

  <div class="mt-auto pt-8">
    <ul class="sidebar-utilities relative flex h-[4.75rem] flex-wrap items-center gap-1" aria-label="Profiles and display settings">
      {
        socials.map(({ href, label, Icon }) => (
            <li class="sidebar-social-item">
              <a
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
                title={label}
                aria-label={label}
                class="inline-flex h-9 w-9 items-center justify-center rounded-pill text-muted transition-colors duration-fast hover:bg-accent-soft/70 hover:text-accent dark:hover:bg-accent-soft/15"
              >
                <Icon size={18} aria-hidden="true" />
              </a>
            </li>
          ))
      }
      <li class="sidebar-theme-item">
        <ThemeToggle />
      </li>
      <li class="sidebar-toggle-item">
        <button
          type="button"
          data-sidebar-toggle
          aria-label="Collapse sidebar"
          aria-expanded="true"
          title="Collapse sidebar"
          class="inline-flex h-9 w-9 items-center justify-center rounded-pill text-muted transition-colors duration-fast hover:bg-accent-soft/70 hover:text-accent dark:hover:bg-accent-soft/15"
        >
          <PanelLeftClose class="sidebar-collapse-icon" size={18} aria-hidden="true" />
          <PanelLeftOpen class="sidebar-expand-icon" size={18} aria-hidden="true" />
        </button>
      </li>
    </ul>
    <p class="sidebar-source meta mt-4 normal-case tracking-normal">
      <a href={profile.links.source} class="hover:text-accent" target="_blank" rel="noopener noreferrer">Source</a>
    </p>
  </div>
</aside>

<script>
  import "@/scripts/scrollSpy";

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-sidebar-toggle]");
  const media = window.matchMedia("(min-width: 1024px) and (max-width: 1279px)");

  const updateToggle = () => {
    if (!toggle) return;
    const compact = root.classList.contains("sidebar-compact");
    toggle.setAttribute("aria-expanded", String(!compact));
    toggle.setAttribute("aria-label", compact ? "Expand sidebar" : "Collapse sidebar");
    toggle.title = compact ? "Expand sidebar" : "Collapse sidebar";
  };

  toggle?.addEventListener("click", () => {
    const compact = root.classList.toggle("sidebar-compact");
    localStorage.setItem("sidebar", compact ? "compact" : "expanded");
    updateToggle();
  });

  media.addEventListener("change", (event) => {
    if (localStorage.getItem("sidebar")) return;
    root.classList.toggle("sidebar-compact", event.matches);
    updateToggle();
  });

  updateToggle();
</script>
