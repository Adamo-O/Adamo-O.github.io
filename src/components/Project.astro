---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, ExternalLink, Github } from "lucide-astro";
import Button from "./Button.astro";
import Skill from "./Skill.astro";

export interface ProjectProps {
  frontmatter: {
    title: string;
    href: string;
    img: ImageMetadata;
    video?: string;
    dates: string;
    skills: string[];
    link?: string;
    github?: string;
    secondLink?: { text: string; link: string };
    subtitle: string;
  };
}

const {
  frontmatter: { title, href, img, video, dates, skills, link, github, secondLink, subtitle },
} = Astro.props as ProjectProps;
const mp4Video = video?.endsWith(".webm") ? video.replace(/\.webm$/, ".mp4") : undefined;
const lowResolutionPreview = img.width <= 640;
---

<article
  id={href}
  class="snap-card group scroll-mt-20 overflow-hidden rounded border border-line bg-surface shadow-card transition-colors duration-fast hover:border-accent/45"
>
  <div class="relative aspect-video overflow-hidden border-b border-line bg-bg/75">
    {
      video ? (
        <video
          data-project-video
          class="absolute inset-0 m-auto h-full w-full max-w-[40rem] object-contain transition-transform duration-slow group-hover:scale-[1.005]"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={img.src}
          aria-hidden="true"
        >
          <source src={video} type="video/webm" />
          {mp4Video && <source src={mp4Video} type="video/mp4" />}
          <Image src={img} alt="" width={960} height={540} class="h-full w-full object-contain" />
        </video>
      ) : (
        <Image
          src={img}
          alt={`${title} project preview`}
          width={1200}
          height={675}
          class:list={[
            "absolute inset-0 m-auto h-full w-full object-contain transition-transform duration-slow group-hover:scale-[1.005]",
            lowResolutionPreview && "max-w-[40rem]",
          ]}
        />
      )
    }
    <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-fg/5"></div>
  </div>

  <div class="grid gap-6 p-5 md:p-7 lg:grid-cols-[minmax(0,1fr)_minmax(16rem,0.38fr)] lg:gap-8">
    <div class="min-w-0">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="meta text-accent">{subtitle}</p>
          <h3 class="mt-2 text-2xl font-bold leading-tight tracking-tight text-fg md:text-3xl">{title}</h3>
        </div>
        <time class="meta pt-1">{dates}</time>
      </div>

      <div class="project-copy mt-5 text-[15px] leading-relaxed text-muted">
        <slot />
      </div>
    </div>

    <div class="flex flex-col justify-between gap-6 lg:border-l lg:border-line lg:pl-7">
      <div>
        <p class="meta mb-3 text-accent">Tools</p>
        <div class="flex flex-wrap gap-1.5">
          {skills.map((skill) => <Skill skill={skill} />)}
        </div>
      </div>

      {(link || github || secondLink) && (
        <div class="flex flex-wrap gap-2 border-t border-line pt-5">
          {link && (
            <Button href={link} newTab variant="outline" size="sm" staticSize>
              <ExternalLink size="14" aria-hidden="true" /> Website
            </Button>
          )}
          {github && (
            <Button href={github} newTab variant="outline" size="sm" staticSize>
              <Github size="14" aria-hidden="true" /> GitHub
            </Button>
          )}
          {secondLink && (
            <Button href={secondLink.link} newTab variant="ghost" size="sm" staticSize>
              {secondLink.text} <ArrowUpRight size="14" aria-hidden="true" />
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .project-copy :global(p) { margin-top: 0.7rem; }
  .project-copy :global(p:first-child) { margin-top: 0; }
  .project-copy :global(br) { display: none; }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const videos = document.querySelectorAll<HTMLVideoElement>("[data-project-video]");

  if (reduceMotion.matches) {
    videos.forEach((video) => video.pause());
  } else if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => undefined);
          else video.pause();
        });
      },
      { rootMargin: "160px 0px" },
    );
    videos.forEach((video) => observer.observe(video));
  }
</script>
