---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, ExternalLink, Github } from "lucide-astro";
import Button from "./Button.astro";
import Skill from "./Skill.astro";
import themeSongStats from "@/data/theme-song-stats.json";

export interface ProjectProps {
  frontmatter: {
    title: string;
    href: string;
    img: ImageMetadata;
    previews?: ImageMetadata[];
    video?: string;
    dates: string;
    skills: string[];
    link?: string;
    github?: string;
    secondLink?: { text: string; link: string };
    subtitle: string;
    highlightSummary?: string;
    impactStats?: { value: string; label: string }[];
    statsSource?: "theme-song";
    mediaTone?: "light" | "dark";
  };
}

const {
  frontmatter: {
    title,
    href,
    img,
    previews,
    video,
    dates,
    skills,
    link,
    github,
    secondLink,
    subtitle,
    highlightSummary,
    impactStats: staticStats,
    statsSource,
    mediaTone = "light",
  },
} = Astro.props as ProjectProps;

/* Stats: `statsSource` reads a build-time JSON in src/data/ that a scheduled
   workflow refreshes, so the figures are never more than a day old with no
   client-side JS. Falls back to the hand-written `impactStats`. */
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const formatUpdated = (yearMonth: string) => {
  const [year, month] = yearMonth.split("-").map(Number);
  return `${MONTHS[month - 1]} ${year}`;
};
const formatCount = (value: number) => value.toLocaleString("en-US");
const statsSources = { "theme-song": themeSongStats };
const liveStats = statsSource ? statsSources[statsSource] : undefined;
const impactStats = liveStats
  ? [
      { value: formatCount(liveStats.profiles), label: "saved profiles" },
      { value: formatCount(liveStats.servers), label: "Discord servers" },
      { value: formatCount(liveStats.introThemes), label: "intro themes" },
    ]
  : staticStats;
const statsUpdated = liveStats ? formatUpdated(liveStats.updated) : undefined;
const isDarkMedia = mediaTone === "dark";
const mp4Video = video?.endsWith(".webm") ? video.replace(/\.webm$/, ".mp4") : undefined;
const visibleSkills = skills.slice(0, 5);
const remainingSkillCount = Math.max(0, skills.length - visibleSkills.length);
---

<article
  id={href}
  class="snap-card group scroll-mt-20 overflow-hidden rounded border border-line bg-surface shadow-card transition-colors duration-fast hover:border-accent/45"
>
  {
    impactStats?.length ? (
      <div class="grid overflow-hidden border-b border-line bg-bg/75 md:grid-cols-[minmax(0,1.45fr)_minmax(14rem,0.55fr)]">
        <div class="flex min-h-[15rem] items-center justify-center p-5 sm:p-7 md:min-h-[20rem]">
          <div
            class:list={[
              "overflow-hidden rounded shadow-card",
              /* Dark tone: a Discord-like panel reads as a framed device, not a hole in the light page. */
              isDarkMedia
                ? "border border-transparent bg-[#1e1f22] dark:ring-1 dark:ring-white/10"
                : "border border-line bg-surface",
            ]}
          >
            <Image
              src={img}
              alt={`${title} running in Discord`}
              width={584}
              densities={[1, 2]}
              class="block h-auto w-full max-w-[30rem]"
            />
          </div>
        </div>

        <dl class="grid grid-cols-3 border-t border-line bg-surface/75 md:grid-cols-1 md:border-l md:border-t-0">
          {impactStats.map((stat, index) => (
            <div
              class:list={[
                "flex min-w-0 flex-col justify-center px-3 py-4 sm:px-5 md:px-6",
                index > 0 && "border-l border-line md:border-l-0 md:border-t",
              ]}
            >
              <dt class="meta order-2 mt-1 leading-snug">{stat.label}</dt>
              <dd class="order-1 text-xl font-bold tabular-nums tracking-tight text-fg sm:text-2xl md:text-3xl">
                {stat.value}
              </dd>
            </div>
          ))}
          {statsUpdated && (
            <div class="col-span-3 border-t border-line px-3 py-2 sm:px-5 md:col-span-1 md:px-6">
              <p class="meta normal-case tracking-normal text-muted">Updated {statsUpdated}</p>
            </div>
          )}
        </dl>
      </div>
    ) : (
      <div class="relative aspect-video overflow-hidden border-b border-line bg-bg/75">
    {
      previews?.length ? (
        <div
          class="project-screen-stage absolute inset-0"
          data-project-preview-stage
          aria-label={`${title} interface preview`}
        >
          {previews.map((preview, index) => (
            <div class:list={["project-screen", index === 1 && "project-screen-offset"]}>
              <Image
                src={preview}
                alt={`${title} interface screen ${index + 1}`}
                width={750}
                height={1800}
                class="h-full w-full object-contain object-top"
              />
            </div>
          ))}
        </div>
      ) : video ? (
        <video
          data-project-video
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-slow group-hover:scale-[1.01]"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={img.src}
          aria-hidden="true"
        >
          <source src={video} type="video/webm" />
          {mp4Video && <source src={mp4Video} type="video/mp4" />}
          <Image src={img} alt="" width={960} height={540} class="h-full w-full object-contain" />
        </video>
      ) : (
        <Image
          src={img}
          alt={`${title} project preview`}
          width={1200}
          height={675}
          class="absolute inset-0 h-full w-full object-contain p-3 transition-transform duration-slow group-hover:scale-[1.005]"
        />
      )
    }
        <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-fg/5"></div>
      </div>
    )
  }

  {/* Same column template as the stats grid above, with padding inside the cells
      rather than on the container, so this divider lands on exactly the same
      x as the stats divider. */}
  <div class="grid md:grid-cols-[minmax(0,1.45fr)_minmax(14rem,0.55fr)]">
    <div class="min-w-0 p-5 md:p-7">
      <div>
        <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <p class="meta text-accent">{subtitle}</p>
          <time class="meta shrink-0">{dates}</time>
        </div>
        <h3 class="mt-2 text-2xl font-bold leading-tight tracking-tight text-fg md:text-3xl">{title}</h3>
      </div>

      <div class="project-copy mt-5 text-[15px] leading-relaxed text-muted">
        {highlightSummary ? <p>{highlightSummary}</p> : <slot />}
      </div>
    </div>

    <div class="flex flex-col justify-between gap-6 border-t border-line p-5 md:border-l md:border-t-0 md:p-7">
      <div>
        <p class="meta mb-3 text-accent">Tools used</p>
        <div class="flex flex-wrap gap-1.5">
          {visibleSkills.map((skill) => <Skill skill={skill} />)}
          {remainingSkillCount > 0 && (
            <span class="inline-flex items-center rounded-pill border border-line bg-bg/70 px-2.5 py-1 text-[11px] font-semibold text-muted">
              +{remainingSkillCount}
            </span>
          )}
        </div>
      </div>

      {(link || github || secondLink) && (
        <div class="flex flex-wrap gap-2 border-t border-line pt-5">
          {link && (
            <Button href={link} newTab variant="outline" size="sm" staticSize>
              <ExternalLink size="14" aria-hidden="true" /> Website
            </Button>
          )}
          {github && (
            <Button href={github} newTab variant="outline" size="sm" staticSize>
              <Github size="14" aria-hidden="true" /> GitHub
            </Button>
          )}
          {secondLink && (
            <Button href={secondLink.link} newTab variant="ghost" size="sm" staticSize>
              {secondLink.text} <ArrowUpRight size="14" aria-hidden="true" />
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .project-copy :global(p) { margin-top: 0.7rem; }
  .project-copy :global(p:first-child) { margin-top: 0; }
  .project-copy :global(br) { display: none; }

  .project-screen-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    padding: clamp(1rem, 3.5vw, 2rem);
    background:
      radial-gradient(circle at 50% 115%, rgb(var(--c-accent) / 0.2), transparent 52%),
      linear-gradient(145deg, rgb(var(--c-accent-soft) / 0.82), rgb(var(--c-bg) / 0.92));
  }

  .project-screen {
    height: 92%;
    width: auto;
    aspect-ratio: 5 / 12;
    overflow: hidden;
    border: 1px solid rgb(var(--c-line));
    border-radius: clamp(0.7rem, 1.5vw, 1.2rem);
    background: white;
    box-shadow: 0 1.1rem 2.5rem -1.35rem rgb(var(--c-fg) / 0.42);
    transform: translateY(-0.2rem) rotate(-1.5deg);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .project-screen-offset {
    transform: translateY(0.65rem) rotate(1.5deg);
  }

  @media (hover: hover) and (pointer: fine) {
    article:hover .project-screen {
      transform: translateY(-0.45rem) rotate(-0.75deg);
    }

    article:hover .project-screen-offset {
      transform: translateY(0.35rem) rotate(0.75deg);
    }
  }

  article.project-preview-in-view .project-screen {
    transform: translateY(-0.45rem) rotate(-0.75deg);
  }

  article.project-preview-in-view .project-screen-offset {
    transform: translateY(0.35rem) rotate(0.75deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-screen,
    .project-screen-offset,
    article:hover .project-screen,
    article:hover .project-screen-offset,
    article.project-preview-in-view .project-screen,
    article.project-preview-in-view .project-screen-offset {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const touchPointer = window.matchMedia("(hover: none), (pointer: coarse)");
  const videos = document.querySelectorAll<HTMLVideoElement>("[data-project-video]");
  const previewStages = document.querySelectorAll<HTMLElement>("[data-project-preview-stage]");

  if (reduceMotion.matches) {
    videos.forEach((video) => video.pause());
  } else if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => undefined);
          else video.pause();
        });
      },
      { rootMargin: "160px 0px" },
    );
    videos.forEach((video) => observer.observe(video));
  }

  if (!reduceMotion.matches && touchPointer.matches && "IntersectionObserver" in window) {
    const previewObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target
            .closest("article")
            ?.classList.toggle("project-preview-in-view", entry.intersectionRatio >= 0.5);
        });
      },
      { threshold: 0.5 },
    );

    previewStages.forEach((stage) => previewObserver.observe(stage));
  }
</script>
