---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, MapPin } from "lucide-astro";
import Skill from "./Skill.astro";
import { cn } from "@/lib/utils";

export interface ExperienceProps {
  frontmatter: {
    position: string;
    company: string;
    href: string;
    type: string;
    dates: string;
    location?: string;
    img?: ImageMetadata;
    logoTone?: "light" | "dark";
    skills: string[];
    link?: string;
    highlightSummary?: string;
    impactStats?: Array<{ value: string; label: string }>;
  };
  variant?: "featured" | "row" | "compact";
  class?: string;
}

const {
  frontmatter: {
    position,
    company,
    type,
    img,
    logoTone = "light",
    dates,
    skills,
    link,
    href,
    location,
    highlightSummary,
    impactStats = [],
  },
  variant = "row",
  class: className,
} = Astro.props as ExperienceProps;

const monogram = company
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("");
const skillLimit = variant === "featured" ? 5 : variant === "row" ? 4 : 3;
const visibleSkills = skills.slice(0, skillLimit);
const remainingSkillCount = Math.max(0, skills.length - visibleSkills.length);
---

{
  variant === "featured" ? (
    <article
      id={href}
      class={cn("snap-card scroll-mt-20 rounded border border-line bg-surface p-5 shadow-card md:p-7", className)}
    >
      <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_auto]">
        <div class="min-w-0">
          <time class="meta">{dates}</time>
          <h3 class="mt-3 text-2xl font-bold leading-tight tracking-tight text-fg md:text-3xl">{position}</h3>
          <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
            {link ? (
              <a class="inline-flex items-center gap-1 font-semibold text-accent hover:text-accent-strong" href={link} target="_blank" rel="noopener noreferrer">
                {company} <ArrowUpRight size={14} aria-hidden="true" />
              </a>
            ) : (
              <p class="font-semibold text-accent">{company}</p>
            )}
            <span class="text-xs font-semibold text-muted">{type}</span>
            {location && (
              <span class="inline-flex items-center gap-1 text-sm text-muted">
                <MapPin size={13} aria-hidden="true" /> {location}
              </span>
            )}
          </div>
        </div>

        <div class="order-first sm:order-none">
          {img ? (
            <div class:list={["flex h-16 w-28 items-center justify-center rounded border border-line p-2.5", logoTone === "dark" ? "bg-[#1f1f1f]" : "bg-white"]}>
              <Image src={img} alt={`${company} logo`} width={176} height={72} class="h-10 w-20 object-contain" />
            </div>
          ) : (
            <div class="flex h-16 w-28 items-center justify-center rounded border border-line bg-accent-soft/60 text-sm font-bold tracking-tight text-accent dark:bg-accent-soft/10" aria-hidden="true">
              {monogram}
            </div>
          )}
        </div>
      </div>

      <div class="experience-copy mt-5 max-w-3xl text-[15px] leading-relaxed text-muted">
        {highlightSummary ? <p>{highlightSummary}</p> : <slot />}
      </div>

      {impactStats.length > 0 && (
        <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded border border-line bg-line sm:grid-cols-4">
          {impactStats.map(({ value, label }) => (
            <div class="min-w-0 bg-bg/55 px-3 py-3 md:px-4">
              <dd class="text-lg font-bold tabular-nums tracking-tight text-fg">{value}</dd>
              <dt class="mt-1 text-[11px] leading-snug text-muted">{label}</dt>
            </div>
          ))}
        </dl>
      )}

      {visibleSkills.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-1.5 border-t border-line pt-4">
          {visibleSkills.map((skill) => <Skill skill={skill} />)}
          {remainingSkillCount > 0 && (
            <span class="inline-flex items-center rounded-pill border border-line bg-bg/70 px-2.5 py-1 text-[11px] font-semibold text-muted">+{remainingSkillCount}</span>
          )}
        </div>
      )}
    </article>
  ) : (
    <article
      id={href}
      class={cn(
        "scroll-mt-20",
        variant === "row" ? "p-4 md:p-5" : "rounded border border-line bg-bg/45 p-4",
        className,
      )}
    >
      <div class="grid gap-4 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-5">
        <div>
          {img ? (
            <div class:list={["flex h-16 w-28 items-center justify-center rounded border border-line p-2.5", logoTone === "dark" ? "bg-[#1f1f1f]" : "bg-white"]}>
              <Image src={img} alt={`${company} logo`} width={176} height={72} class="h-10 w-20 object-contain" />
            </div>
          ) : (
            <div class="flex h-16 w-28 items-center justify-center rounded border border-line bg-accent-soft/60 text-xs font-bold tracking-tight text-accent dark:bg-accent-soft/10" aria-hidden="true">
              {monogram}
            </div>
          )}
        </div>

        <div class="min-w-0">
          <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
            <div>
              <h3 class="text-lg font-bold leading-tight tracking-tight text-fg md:text-xl">{position}</h3>
              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                {link ? (
                  <a class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:text-accent-strong" href={link} target="_blank" rel="noopener noreferrer">
                    {company} <ArrowUpRight size={13} aria-hidden="true" />
                  </a>
                ) : (
                  <p class="text-sm font-semibold text-accent">{company}</p>
                )}
                <span class="text-xs font-semibold text-muted">{type}</span>
                {location && (
                  <span class="inline-flex items-center gap-1 text-xs text-muted">
                    <MapPin size={12} aria-hidden="true" /> {location}
                  </span>
                )}
              </div>
            </div>
            <time class="meta shrink-0">{dates}</time>
          </div>

          <div class="experience-copy mt-3 text-sm leading-relaxed text-muted">
            {highlightSummary ? <p>{highlightSummary}</p> : <slot />}
          </div>

          {visibleSkills.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {visibleSkills.map((skill) => <Skill skill={skill} />)}
              {remainingSkillCount > 0 && (
                <span class="inline-flex items-center rounded-pill border border-line bg-bg/70 px-2.5 py-1 text-[11px] font-semibold text-muted">+{remainingSkillCount}</span>
              )}
            </div>
          )}
        </div>
      </div>
    </article>
  )
}

<style>
  .experience-copy :global(p) { margin-top: 0.65rem; }
  .experience-copy :global(p:first-child) { margin-top: 0; }
  .experience-copy :global(br) { display: none; }
</style>
