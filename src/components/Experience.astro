---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, MapPin } from "lucide-astro";
import Skill from "./Skill.astro";

export interface ExperienceProps {
  frontmatter: {
    position: string;
    company: string;
    href: string;
    type: string;
    dates: string;
    location?: string;
    img?: ImageMetadata;
    logoTone?: "light" | "dark";
    logoWide?: boolean;
    skills: string[];
    link?: string;
    impactStats?: Array<{ value: string; label: string }>;
  };
  compact?: boolean;
}

const {
  frontmatter: {
    position,
    company,
    type,
    img,
    logoTone = "light",
    logoWide = false,
    dates,
    skills,
    link,
    href,
    location,
    impactStats = [],
  },
  compact = false,
} = Astro.props as ExperienceProps;
const monogram = company
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("");
---

<article
  id={href}
  class:list={[
    "snap-card scroll-mt-20 rounded border border-line bg-surface shadow-card",
    compact ? "p-4 md:p-5" : "p-5 md:p-7",
  ]}
>
  <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_auto]">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="meta rounded-pill bg-accent-soft/70 px-2 py-1 text-accent dark:bg-accent-soft/10">{type}</span>
        <time class="meta">{dates}</time>
      </div>
      <h3 class:list={["mt-3 font-bold leading-tight tracking-tight text-fg", compact ? "text-xl" : "text-2xl md:text-3xl"]}>
        {position}
      </h3>
      <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
        {
          link ? (
            <a class="inline-flex items-center gap-1 font-semibold text-accent hover:text-accent-strong" href={link} target="_blank" rel="noopener noreferrer">
              {company} <ArrowUpRight size="14" aria-hidden="true" />
            </a>
          ) : (
            <p class="font-semibold text-accent">{company}</p>
          )
        }
        {location && (
          <span class="inline-flex items-center gap-1 text-sm text-muted">
            <MapPin size="13" aria-hidden="true" /> {location}
          </span>
        )}
      </div>
    </div>

    <div class="order-first sm:order-none">
      {
        img ? (
          <div
            class:list={[
              "flex h-16 items-center justify-center rounded border border-line p-2.5",
              logoWide ? "w-28" : "w-20",
              logoTone === "dark" ? "bg-[#1f1f1f]" : "bg-white",
            ]}
          >
            <Image src={img} alt={`${company} logo`} width={160} height={80} class="max-h-full w-auto object-contain" />
          </div>
        ) : (
          <div class="flex h-16 w-16 items-center justify-center rounded border border-line bg-accent-soft/60 font-mono text-sm font-bold tracking-[0.12em] text-accent dark:bg-accent-soft/10" aria-hidden="true">
            {monogram}
          </div>
        )
      }
    </div>
  </div>

  <div class="experience-copy mt-5 max-w-3xl text-[15px] leading-relaxed text-muted">
    <slot />
  </div>

  {impactStats.length > 0 && (
    <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded border border-line bg-line sm:grid-cols-4">
      {impactStats.map(({ value, label }) => (
        <div class="min-w-0 bg-bg/55 px-3 py-3 md:px-4">
          <dd class="text-lg font-bold tabular-nums tracking-tight text-fg">{value}</dd>
          <dt class="mt-1 text-[11px] leading-snug text-muted">{label}</dt>
        </div>
      ))}
    </dl>
  )}

  {skills.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-1.5 border-t border-line pt-4">
      {skills.map((skill) => <Skill skill={skill} />)}
    </div>
  )}
</article>

<style>
  .experience-copy :global(p) { margin-top: 0.65rem; }
  .experience-copy :global(p:first-child) { margin-top: 0; }
  .experience-copy :global(br) { display: none; }
</style>
