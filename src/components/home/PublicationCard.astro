---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, Code2, FileText, Maximize2, X } from "lucide-astro";

interface Props {
  publication: {
    title: string;
    authors: string[];
    venue?: string;
    year: number;
    status: "under-review" | "accepted" | "preprint" | "workshop" | "withdrawn";
    summary: string;
    thumbnail?: ImageMetadata;
    thumbnailAlt?: string;
    thumbnailCaption?: string;
    thumbnailFrame?: "wide" | "extra-wide";
    highlight?: boolean;
    links: {
      pdf?: string;
      arxiv?: string;
      code?: string;
      project?: string;
      openreview?: string;
      secondary?: { label: string; url: string };
    };
    topics: string[];
  };
}

const { publication } = Astro.props as Props;
const statusLabels = {
  "under-review": "Under review",
  accepted: "Accepted",
  preprint: "Preprint",
  workshop: "Workshop",
  withdrawn: "Withdrawn submission",
};
const links = [
  { href: publication.links.arxiv, label: "arXiv", Icon: FileText },
  { href: publication.links.openreview, label: "OpenReview", Icon: ArrowUpRight },
  { href: publication.links.pdf, label: "PDF", Icon: FileText },
  { href: publication.links.code, label: "Code", Icon: Code2 },
  { href: publication.links.project, label: "Project", Icon: ArrowUpRight },
  {
    href: publication.links.secondary?.url,
    label: publication.links.secondary?.label ?? "Related link",
    Icon: ArrowUpRight,
  },
].filter((link) => link.href);
---

<article
  class:list={[
    "grid overflow-hidden rounded border bg-surface shadow-card lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[18rem_minmax(0,1fr)]",
    publication.highlight ? "border-accent/45" : "border-line",
  ]}
>
  {
    publication.thumbnail && publication.thumbnailAlt && (
      <figure class="border-b border-line bg-bg/60 p-3 lg:flex lg:items-center lg:border-b-0 lg:border-r">
        {/* The card thumbnail is too small to read on desktop, so it opens the full,
            uncropped figure in a dialog. */}
        <button
          type="button"
          class="group relative mx-auto block w-full cursor-zoom-in rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          aria-label={`Enlarge figure: ${publication.title}`}
          data-figure-open
        >
          <div
            class:list={[
              "relative w-full overflow-hidden rounded-sm border border-line/70 bg-white",
              publication.thumbnailFrame === "extra-wide" ? "aspect-[2.7/1]" : "aspect-[2.25/1]",
            ]}
          >
            <Image
              src={publication.thumbnail}
              alt={publication.thumbnailAlt}
              width={1600}
              height={720}
              class="absolute inset-0 h-full w-full object-cover object-center"
            />
          </div>
          <span
            class="absolute bottom-1.5 right-1.5 flex h-7 w-7 items-center justify-center rounded-sm border border-line bg-surface/90 text-muted shadow-card transition-colors group-hover:text-accent"
            aria-hidden="true"
          >
            <Maximize2 size={14} />
          </span>
        </button>
        <dialog
          class="publication-figure m-auto w-[min(94vw,88rem)] max-w-none rounded border border-line bg-surface p-0 text-fg shadow-card"
          aria-label={publication.title}
        >
          <div class="flex items-start justify-between gap-4 border-b border-line px-4 py-3">
            <p class="text-sm font-semibold leading-snug">{publication.thumbnailCaption ?? publication.title}</p>
            <form method="dialog">
              <button
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-sm text-muted hover:bg-bg hover:text-fg"
                aria-label="Close figure"
              >
                <X size={18} aria-hidden="true" />
              </button>
            </form>
          </div>
          <div class="bg-white p-3 md:p-5">
            <Image
              src={publication.thumbnail}
              alt={publication.thumbnailAlt}
              width={Math.min(2400, publication.thumbnail.width)}
              loading="lazy"
              class="mx-auto max-h-[80vh] w-full object-contain"
            />
          </div>
        </dialog>
      </figure>
    )
  }
  <div class="flex min-w-0 flex-col p-4 md:p-5">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class:list={[
          "meta rounded-pill px-2 py-1 tracking-[0.08em]",
          publication.status === "accepted"
            ? "bg-badge-accepted/10 text-badge-accepted"
            : publication.status === "withdrawn"
              ? "bg-line/60 text-muted"
              : "bg-badge-review/10 text-badge-review",
        ]}
      >
        {/* An accepted badge's colour already says "accepted", and the venue name carries the year. */}
        {publication.status === "accepted" && publication.venue
          ? publication.venue
          : statusLabels[publication.status]}
      </span>
      {publication.topics.length > 0 && <span class="meta ml-auto">{publication.topics.join(" / ")}</span>}
    </div>
    <h3 class="mt-3 text-lg font-bold leading-snug tracking-tight text-fg md:text-xl">
      {publication.title}
    </h3>
    <p class="mt-1.5 text-sm leading-relaxed text-muted">
      {/* The separator must live inside the same expression as the name, or the
          markup's own indentation becomes a text node and renders "A , B". */}
      {publication.authors.map((author, index) => (
        <span class:list={[author === "Adamo Orsini" && "font-semibold text-fg"]}>
          {author}{index < publication.authors.length - 1 ? ", " : ""}
        </span>
      ))}
    </p>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{publication.summary}</p>
    {
      links.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-4">
          {links.map(({ href, label, Icon }) => (
            <a class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-strong md:min-h-0" href={href} target="_blank" rel="noopener noreferrer">
              <Icon size="15" aria-hidden="true" /> {label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .publication-figure::backdrop {
    background: rgb(0 0 0 / 0.7);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-figure-open]").forEach((button) => {
    const dialog = button.parentElement?.querySelector("dialog");
    if (!dialog) return;
    button.addEventListener("click", () => dialog.showModal());
    // A click that lands on the dialog element itself is a click on the backdrop.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
