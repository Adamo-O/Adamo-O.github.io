---
interface Props {
  education: {
    degree: string;
    field: string;
    institution: string;
    location: string;
    start: string;
    end: string;
    expected: boolean;
    gpa?: string;
    notes: string[];
  };
}

const { education } = Astro.props as Props;
const formatMonth = (value: string) => {
  const [year, month] = value.split("-").map(Number);
  return new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(
    new Date(Date.UTC(year, month - 1, 1)),
  );
};
---

<li class="relative grid gap-2 py-6 pl-8 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-6">
  <span class="absolute left-0 top-[1.65rem] h-[11px] w-[11px] rounded-pill border-[3px] border-bg bg-accent"></span>
  <p class="meta pt-1">
    {formatMonth(education.start)} - {formatMonth(education.end)}{education.expected ? " · Expected" : ""}
  </p>
  <div>
    <h3 class="text-xl font-bold leading-snug text-fg">
      {education.degree} in {education.field}
    </h3>
    <p class="mt-1 font-medium text-accent">{education.institution}</p>
    <p class="mt-1 text-sm text-muted">{education.location}{education.gpa ? ` · GPA ${education.gpa}` : ""}</p>
    {education.notes.length > 0 && (
      <ul class="mt-3 grid list-disc gap-1.5 pl-4 text-sm leading-relaxed text-muted marker:text-accent">
        {education.notes.map((note) => <li>{note}</li>)}
      </ul>
    )}
  </div>
</li>
