---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, Github } from "lucide-astro";

interface Props {
  frontmatter: {
    title: string;
    href: string;
    img: ImageMetadata;
    video?: string;
    dates: string;
    subtitle: string;
    highlightSummary?: string;
    link?: string;
    github?: string;
    secondLink?: { text: string; link: string };
  };
}

const { frontmatter } = Astro.props as Props;
const { title, href, img, video, dates, subtitle, highlightSummary, link, github, secondLink } = frontmatter;
const mp4Video = video?.endsWith(".webm") ? video.replace(/\.webm$/, ".mp4") : undefined;
const actions = [
  link && { href: link, label: "Website", Icon: ArrowUpRight },
  github && { href: github, label: "GitHub", Icon: Github },
  secondLink && { href: secondLink.link, label: secondLink.text, Icon: ArrowUpRight },
].filter(Boolean) as Array<{ href: string; label: string; Icon: typeof ArrowUpRight }>;
---

<article id={href} class="group min-w-0 overflow-hidden rounded border border-line bg-surface transition-colors duration-fast hover:border-accent/45">
  <div class="relative aspect-video overflow-hidden border-b border-line bg-bg/70">
    {video ? (
      <video
        data-project-video
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-slow group-hover:scale-[1.01]"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={img.src}
        aria-hidden="true"
      >
        <source src={video} type="video/webm" />
        {mp4Video && <source src={mp4Video} type="video/mp4" />}
      </video>
    ) : (
      <Image
        src={img}
        alt={`${title} project preview`}
        width={720}
        height={405}
        class="absolute inset-0 h-full w-full object-contain p-4 transition-transform duration-slow group-hover:scale-[1.015]"
      />
    )}
  </div>
  <div class="min-w-0 p-4">
    <p class="meta text-accent">{subtitle}</p>
    <h4 class="mt-1.5 text-base font-bold leading-snug tracking-tight text-fg">{title}</h4>
    {highlightSummary && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{highlightSummary}</p>}
    <time class="mt-3 block text-xs font-medium text-muted">{dates}</time>
    {actions.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {actions.map(({ href, label, Icon }) => (
          <a class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:text-accent-strong" href={href} target="_blank" rel="noopener noreferrer">
            {label} <Icon size={12} aria-hidden="true" />
          </a>
        ))}
      </div>
    )}
  </div>
</article>
