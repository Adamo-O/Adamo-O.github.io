---
/**
 * Link styled as a button. API unchanged from the previous site:
 *  href, title?, newTab?, className?, display?, staticSize?, variant?, size?
 * Variants: default | outline | ghost | link. Sizes: default | sm | lg | icon.
 * Renders a plain <a> with the shared buttonVariants classes (no React island).
 */
import { cn } from "@/lib/utils";
import { buttonVariants, type ButtonProps } from "./ui/button";

interface Props extends Pick<ButtonProps, "variant" | "size"> {
  href: string;
  title?: string;
  newTab?: boolean;
  className?: string;
  display?: "block" | "inline-block" | "flex" | "inline" | "inline-flex";
  staticSize?: boolean;
}

const {
  href,
  title,
  newTab = false,
  className,
  display = "inline-flex",
  variant = "default",
  size = "default",
  staticSize = false,
} = Astro.props;
---

<a
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  title={title}
  aria-label={title}
  class={cn(
    buttonVariants({ variant, size }),
    !staticSize && "max-md:w-full",
    className,
  )}
  style={`display: ${display}`}
>
  <slot />
</a>
