---
import { cn } from "@/lib/utils";
import { skillIcons } from "@/lib/skillIcons";

interface SkillProps {
  skill: string;
}

const { skill } = Astro.props as SkillProps;
---

<span
  class={cn(
    "inline-flex max-w-full items-center gap-1.5 rounded-pill border border-line bg-bg/70 px-2.5 py-1 text-[11px] font-semibold text-muted",
  )}
>
  {skillIcons[skill] && <i class={cn(skillIcons[skill], "text-[0.72rem] text-accent")} aria-hidden="true"></i>}
  {skill}
</span>
