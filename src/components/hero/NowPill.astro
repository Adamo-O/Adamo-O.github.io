---
/**
 * "Now / Sep 2026 / <text>" status pill. The month is hidden once
 * `updated` is more than four months old so a stale date never shows.
 */
interface Props {
  text: string;
  /** ISO-ish date, e.g. "2026-09" or "2026-09-01". */
  updated: string;
  class?: string;
}

const { text, updated, class: className } = Astro.props;

const MAX_AGE_MS = 4 * 30.5 * 24 * 60 * 60 * 1000;
const parsed = new Date(updated);
const valid = !Number.isNaN(parsed.getTime());
const fresh = valid && Date.now() - parsed.getTime() <= MAX_AGE_MS;
const stamp = fresh
  ? `${parsed.toLocaleString("en-US", { month: "short", timeZone: "UTC" })} ${parsed.getUTCFullYear()}`
  : null;
---

{
  text && (
    <p
      class:list={[
        "inline-flex max-w-full items-start gap-2.5 rounded-2xl border border-line bg-surface py-1.5 pl-3 pr-4 text-sm text-fg shadow-card sm:items-center sm:rounded-pill",
        className,
      ]}
    >
      <span class="h-1.5 w-1.5 shrink-0 rounded-pill bg-accent" aria-hidden="true" />
      <span class="shrink-0 text-xs font-semibold text-muted">
        Now{stamp && <span aria-hidden="true"> / </span>}{stamp}
      </span>
      <span class="min-w-0 leading-snug">{text}</span>
    </p>
  )
}
