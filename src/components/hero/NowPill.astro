---
/** "Now / <text>" status pill. */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

{
  text && (
    <p
      class:list={[
        "inline-grid max-w-full grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-3 rounded-2xl border border-line bg-surface py-1.5 pl-3 pr-4 text-sm text-fg shadow-card sm:rounded-pill",
        className,
      ]}
    >
      <span class="inline-flex shrink-0 items-center gap-2.5 whitespace-nowrap text-xs font-semibold text-muted">
        <span class="h-1.5 w-1.5 shrink-0 rounded-pill bg-accent" aria-hidden="true" />
        <span>Now</span>
      </span>
      <span class="min-w-0 leading-snug">{text}</span>
    </p>
  )
}
