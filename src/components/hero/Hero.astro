---
/**
 * Hero block: particle field behind the intro copy from profile.ts, two
 * CTAs (Email, CV), the "now" pill and the live Discord/Spotify status.
 * Designed to sit inside <Section id="about">; it does not wrap a <section>.
 */
import { Mail, FileText } from "lucide-astro";
import Button from "@/components/Button.astro";
import LiveStatus from "@/components/LiveStatus/LiveStatus.astro";
import { profile } from "@/data/profile";
import ParticleField from "./ParticleField";
import NowPill from "./NowPill.astro";

const [lead, ...rest] = profile.heroLines;
const roleLine = [profile.role, ...profile.affiliations].join(" · ");
---

<div class="relative isolate">
  <ParticleField client:idle className="-z-10" />

  <div class="flex max-w-[52rem] flex-col gap-7 py-6 md:gap-8 md:py-10">
    <div class="space-y-4">
      <h1 class="text-display font-bold text-fg">
        Hi, I'm {profile.name}.
      </h1>
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
        {roleLine}
      </p>
      {lead && <p class="text-lg leading-snug text-fg md:text-xl">{lead}</p>}
      {
        rest.length > 0 && (
          <div class="space-y-2 text-[15px] leading-relaxed text-muted">
            {rest.map((line) => <p>{line}</p>)}
          </div>
        )
      }
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <Button
        href={`mailto:${profile.personalEmail}`}
        title={`Send an email to ${profile.personalEmail}`}
        variant="default"
        staticSize
      >
        <Mail class="mr-2" size="18" aria-hidden="true" />
        Email me
      </Button>
      <Button href={profile.cvPdf} title="Open CV (PDF)" newTab variant="outline" staticSize>
        <FileText class="mr-2" size="18" aria-hidden="true" />
        CV
      </Button>
    </div>

    <div>
      <NowPill text={profile.now.text} updated={profile.now.updated} />
    </div>

    <div class="border-t border-line pt-5">
      <LiveStatus class="justify-start" />
    </div>
  </div>
</div>
