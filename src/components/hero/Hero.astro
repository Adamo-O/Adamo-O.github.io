---
/**
 * Hero block: intro copy from profile.ts beside the portrait, one labelled
 * contact row (CV included, same weight as the rest) and the pinned
 * publication's acceptance row.
 * Designed to sit inside <Section id="about">; it does not wrap a <section>.
 *
 * Research CTA intentionally absent: it duplicates the persistent mobile tab bar
 * and the desktop sidebar, and its target is the next section down.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { FileText, Github, GraduationCap, Linkedin, Mail } from "lucide-astro";
import { profile } from "@/data/profile";

type Publication = CollectionEntry<"publications">["data"];

interface Props {
  portrait?: ImageMetadata;
  latest?: Publication;
}

const { portrait, latest } = Astro.props;
const lead = profile.heroLines[0];

/** "Accepted at Findings of AACL-IJCNLP 2026" from status + venue; nothing hand-written. */
const statusPhrase = (publication: Publication): string => {
  const venue = publication.venue?.trim();
  switch (publication.status) {
    case "accepted":
      return venue ? `Accepted at ${venue}` : "Accepted";
    case "workshop":
      return venue ? `Workshop paper at ${venue}` : "Workshop paper";
    case "preprint":
      return venue ? `Preprint · ${venue}` : "Preprint";
    case "under-review":
      return "Under review";
    case "withdrawn":
      return "Withdrawn";
  }
};

// The schema records the year only, so the eyebrow prints the year (never a guessed
// month) and skips it when the venue already carries it.
const latestEyebrow = latest
  ? latest.venue?.includes(String(latest.year))
    ? statusPhrase(latest)
    : `${latest.year} · ${statusPhrase(latest)}`
  : "";
const latestHref =
  latest?.links.arxiv ?? latest?.links.openreview ?? latest?.links.pdf ?? latest?.links.project;

/** One row of equal-weight pill chips, each with a text label (Adamo 2026-11-02):
    the CV is no longer a filled button, and on phones the chips wrap 3 + 2. Email is a mailto, so it takes no target/rel. Scholar
    is back now that the profile lists TAG-Nav (removed 2026-09-11 while empty). */
const profileLinks: Array<[label: string, href: string, external: boolean, Icon: any]> = [
  ["Email", `mailto:${profile.academicEmail}`, false, Mail],
  ...(profile.links.scholar
    ? [["Scholar", profile.links.scholar, true, GraduationCap] as [string, string, boolean, any]]
    : []),
  ["LinkedIn", profile.links.linkedin, true, Linkedin],
  ["GitHub", profile.links.github, true, Github],
  ["CV", profile.cvPdf, true, FileText],
];
---

<div>
  {/* Portrait sits in a left gutter; everything else shares ONE text column, so the
      name, lead, CTAs, acceptance card and Now pill all start on the same edge. */}
  <div class="flex flex-col gap-5 py-6 sm:flex-row sm:items-start sm:gap-7 md:py-10">
    {
      portrait && (
        <Image
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          width={112}
          densities={[1, 2]}
          class="h-20 w-20 shrink-0 rounded-2xl border border-line object-cover md:h-28 md:w-28"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="flex min-w-0 flex-1 flex-col gap-7 md:gap-8">
      <div class="space-y-4">
        <h1 class="text-display font-bold text-fg">
          Hi, I'm {profile.name}.
        </h1>
        {lead && <p class="max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{lead}</p>}
      </div>

    <nav class="flex flex-wrap items-center gap-2" aria-label="Profiles and contact">
      {
        profileLinks.map(([label, href, external, Icon]) => (
          <a
            href={href}
            title={label === "CV" ? "Open CV (PDF)" : undefined}
            {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class="inline-flex h-11 items-center gap-2 rounded-pill border border-line bg-surface px-4 text-sm font-medium text-fg/80 transition-colors duration-fast hover:border-accent hover:text-accent focus-visible:border-accent focus-visible:text-accent"
          >
            <Icon size="16" aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </nav>

    {
      latest && (
        <div class="rounded-2xl border border-line bg-surface px-5 py-4 shadow-card">
          <p class="meta">
            <span class="sr-only">Latest: </span>
            {latestEyebrow}
          </p>
          <p class="mt-1.5 text-lg font-semibold leading-snug text-fg">
            {latestHref ? (
              <a
                href={latestHref}
                target="_blank"
                rel="noopener noreferrer"
                class="underline-offset-4 transition-colors duration-fast hover:text-accent hover:underline"
              >
                {latest.title}
              </a>
            ) : (
              latest.title
            )}
          </p>
        </div>
      )
    }
    </div>
  </div>
</div>
